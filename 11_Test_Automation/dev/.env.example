# Postgres connection string, e.g. postgres://user:pass@host/db?sslmode=require
# (Neon/Vercel Postgres/Supabase all give you one of these). For local dev,
# create a separate dev database and put its connection string here — never
# point local dev at the real class database.
DATABASE_URL=

# Secret used to sign teacher session cookies. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Optional: only needed for "Fully offline local development" (see
# README.md) -- a genuinely local Postgres instead of a cloud one. Leave
# these blank/unset for a normal cloud-backed setup.

# Your cloud database's connection string, kept here for reference and for
# pointing tooling (verify_deployment.py, load_test.py,
# triplet_coverage_monitor.py) at production explicitly via their
# --database-url/--base-url flags once DATABASE_URL above points locally.
CLOUD_DATABASE_URL=

# Machine-specific paths to a portable Postgres install (see README.md),
# used by db/local-db.ps1 to start/stop it.
PGBIN=
PGDATA_LOCAL=
PGPORT_LOCAL=5432
